{
  "name": "building-safety-app",
  "version": "1.0.4",
  "private": true,
  "main": "electron/main.js",
  "description": "스마트 건축물 안전점검 현장점검 — PWA + Android(Capacitor)",
  "scripts": {
    "test": "node scripts/run-node-tests.js",
    "prepare:www": "powershell -ExecutionPolicy Bypass -File ./scripts/prepare-www.ps1",
    "cap:sync": "npm run prepare:www && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:sync": "npm run cap:sync",
    "android:open": "npm run cap:open",
    "android:setup": "powershell -ExecutionPolicy Bypass -File ./scripts/android-setup.ps1",
    "android:build:debug": "node scripts/bump-mobile-version.js && npm run android:setup && npm run cap:sync && cd android && .\\gradlew.bat assembleDebug && node scripts/upload-mobile-release.js",
    "android:upload": "node scripts/upload-mobile-release.js",
    "electron": "electron electron/main.js",
    "electron:dist": "node scripts/bump-desktop-version.js && electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "kr.buildingsafety.inspection.desktop",
    "productName": "스마트 안전점검",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "index.html",
      "app.js",
      "styles.css",
      "sw.js",
      "manifest.json",
      "photo-capture.html",
      "report-summary.html",
      "web-version.json",
      "js/**/*",
      "templates/**/*",
      "branding/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "스마트 안전점검",
      "include": "electron/installer.nsh"
    }
  }
}

rules_version = '2';

// building-safety-app Firestore 보안 규칙
//
// 데이터 모델 요약 (app.js 기준):
//   users/{uid}                                → 사용자 본인 프로필 (본인만 읽기/쓰기)
//   companies/{companyId}                      → 회사 문서 (adminUid, joinCode 등)
//   companies/{companyId}/members/{uid}         → 승인된 팀원 (role: admin|member)
//   companies/{companyId}/pendingRequests/{uid} → 가입 승인 대기
//   companies/{companyId}/rejectedRequests/{uid}→ 가입 거절 이력
//   joinCodes/{code}                            → 회사 검색·식별코드 조회용 (가입 전 미인증 상태에서도 읽기 가능)
//   safety_app/{companyId}                      → 회사별 건물/결함 메타데이터 (실시간 동기화 대상)
//   safety_app/{companyId}/floorDrawings/{id}   → 층별 도면 이미지(dataUrl)
//   safety_app/{companyId}/floorDrawingPdfs/{id} → 층별 PDF 원본(dataUrl 또는 parts 서브컬렉션)
//   safety_app/{companyId}/siteDrawingVault/{siteKey}/floors/{floorCode} → 현장명 기준 PDF 보관함(건물 삭제 후에도 유지)
//   safety_app/{companyId}/photos/{id}          → 결함 사진(dataUrl)
//
// 배포 방법: Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에 이 파일 내용을 붙여넣고 게시(Publish).
// (Firebase CLI를 쓴다면: firebase deploy --only firestore:rules)

service cloud.firestore {
  match /databases/{database}/documents {

    // 요청자가 해당 회사의 승인된 멤버(admin 또는 member)인지 확인
    function isCompanyMember(companyId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    // 요청자가 해당 회사의 admin인지 확인
    function isCompanyAdmin(companyId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // --- users/{uid}: 본인만 읽고 쓸 수 있음 ---
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      // 회사 소속·가입 신청 상태만 본인 또는 해당 회사 admin이 갱신할 수 있다.
      function membershipFieldsOnly() {
        let allowed = ['companyId', 'companyName', 'role', 'pendingCompanyId', 'pendingCompanyName', 'defectPinPresets', 'defectPinPresetsUpdatedAt'];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
      }
      function selfProfileFieldsOnly() {
        let allowed = ['defectPinPresets', 'defectPinPresetsUpdatedAt'];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
      }
      function adminCompanyIdForUserUpdate() {
        return resource.data.get('pendingCompanyId', resource.data.get('companyId', ''));
      }
      allow update: if request.auth != null && (
        (request.auth.uid == uid && membershipFieldsOnly()) ||
        (request.auth.uid == uid && selfProfileFieldsOnly()) ||
        (request.auth.uid != uid && membershipFieldsOnly() &&
          adminCompanyIdForUserUpdate() != '' &&
          isCompanyAdmin(adminCompanyIdForUserUpdate()))
      );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // --- joinCodes/{code}: 회사명 검색·식별코드 확인을 위해 로그인 전(팀원 가입 화면)에도 읽혀야 함 ---
    match /joinCodes/{code} {
      allow read: if true;
      // 새 회사를 막 생성한 관리자 본인만 자신의 회사에 대한 코드를 생성 가능
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)) &&
        get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- companies/{companyId}: 회사 메타 문서 ---
    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId);
      // 회사 생성: 인증된 사용자가 자기 자신을 adminUid로 하는 새 문서를 생성할 때만 허용
      allow create: if request.auth != null && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if isCompanyAdmin(companyId);

      // members: 본인 문서는 스스로 read 가능(로그인 시 상태 조회), 목록 조회/쓰기는 admin만
      match /members/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isCompanyAdmin(companyId));
        allow list: if isCompanyAdmin(companyId);
        // 회사 최초 생성 시 admin 본인 문서 생성 + 이후 admin이 팀원을 승인 등록
        allow create: if request.auth != null &&
          (request.auth.uid == uid || isCompanyAdmin(companyId));
        allow update: if isCompanyAdmin(companyId);
        // 팀원 탈퇴(본인) 또는 관리자가 멤버 제거
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || isCompanyAdmin(companyId));
      }

      // pendingRequests: 본인이 신청서 생성, 본인 상태 조회, admin이 목록/삭제 처리
      match /pendingRequests/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isCompanyAdmin(companyId));
        allow list: if isCompanyAdmin(companyId);
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
        // 가입 대기 취소(본인) 또는 관리자 거절 처리
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || isCompanyAdmin(companyId));
      }

      // rejectedRequests: admin만 생성, 본인은 자신의 거절 상태만 조회 가능
      match /rejectedRequests/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isCompanyAdmin(companyId));
        allow list: if isCompanyAdmin(companyId);
        allow create: if isCompanyAdmin(companyId);
        allow update: if false;
        // 거절 이력 정리(본인 탈퇴 시)
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // --- safety_app/{companyId}: 건물/결함 데이터 + 도면/사진 서브컬렉션 ---
    // 해당 회사의 승인된 멤버(admin/member)만 읽고 쓸 수 있음
    match /safety_app/{companyId} {
      allow read, write: if isCompanyMember(companyId);

      match /floorDrawings/{docId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /floorDrawingPdfs/{docId} {
        allow read, write: if isCompanyMember(companyId);

        match /parts/{partId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }

      // 도면 배율별(4000/8000/16000 등) 캐시 — floorDrawings/floorDrawingPdfs와 같은 회사 소속
      // 규칙인데 이 컬렉션만 빠져 있어서 "Missing or insufficient permissions"로 항상 막혀 있었다.
      match /floorDrawingTiers/{docId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /photos/{docId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /siteDrawingVault/{siteKey} {
        allow read, write: if isCompanyMember(companyId);

        match /floors/{floorCode} {
          allow read, write: if isCompanyMember(companyId);

          match /parts/{partId} {
            allow read, write: if isCompanyMember(companyId);
          }
        }
      }
    }

    // --- photoRelay/{sessionId}/photos/{photoId}: 태블릿↔휴대폰 실시간 사진 촬영 연동 ---
    // 휴대폰은 회사 계정 로그인 없이 Firebase 익명 인증(Anonymous Auth)만으로 접근.
    // 세션ID(QR코드)를 아는 사람만 쓸 수 있고, 임시 중계용이라 정식 결함 데이터에는 접근 불가.
    match /photoRelay/{sessionId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;

      match /photos/{photoId} {
        allow read, create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // --- app_meta/android_release: OTA 앱 업데이트 메타 ---
    // 필드 예: { versionCode, versionName, apkUrl, notes?, mandatory? }
    // 쓰기: users/{uid}.otaPublisher == true 인 계정만
    function isOtaPublisher() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('otaPublisher', false) == true;
    }

    match /app_meta/{docId} {
      allow read: if request.auth != null;
      allow create, update: if docId == 'android_release' && isOtaPublisher();
      allow delete: if false;
    }

    // 그 외 모든 경로는 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

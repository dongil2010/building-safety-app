rules_version = '2';

// building-safety-app Firestore 보안 규칙
//
// 데이터 모델 요약 (app.js 기준):
//   users/{uid}                                → 사용자 본인 프로필 (본인만 읽기/쓰기)
//   companies/{companyId}                      → 회사 문서 (adminUid, joinCode 등)
//   companies/{companyId}/members/{uid}         → 승인된 팀원 (role: admin|member)
//   companies/{companyId}/pendingRequests/{uid} → 가입 승인 대기
//   companies/{companyId}/rejectedRequests/{uid}→ 가입 거절 이력
//   joinCodes/{code}                            → 식별코드 단건 get은 공개, 컬렉션 list는 로그인 사용자만
//   safety_app/{companyId}                      → 회사별 건물 목록/설정 메타데이터 (실시간 동기화 대상)
//   safety_app/{companyId}/sites/{site}/rounds/{round}/floors/{floor}  (단동 층 묶음 JSON)
//   safety_app/{companyId}/sites/{site}/rounds/{round}/dongs/{dong}/floors/{floor}  (다동)
//     층 문서 1개에 markings+photos+ndt+drawing JSON (1MB 넘으면 parts 청크)
//     구버전: 같은 층 아래 docs/{kind} (kind = markings|photos|ndt|drawing) — 읽기 폴백만
//   safety_app/{companyId}/bulkData/defectsAndNdt → 구버전 결함/NDT 묶음 (층 문서 없을 때만 읽기 폴백)
//   safety_app/{companyId}/floorDrawings/{id}   → 층별 도면 이미지(dataUrl)
//   safety_app/{companyId}/floorDrawingPdfs/{id} → 층별 PDF 원본(dataUrl 또는 parts 서브컬렉션)
//   safety_app/{companyId}/siteDrawingVault/{siteKey}/floors/{floorCode} → 현장명 기준 PDF 보관함(건물 삭제 후에도 유지)
//   safety_app/{companyId}/syncLeases/{id}      → 동기화 잠금(heartbeat). 회사 루트/층 문서와 분리
//
// 배포 방법: main에 push하면 .github/workflows/deploy-web.yml의 `rules` 작업이 이 파일을
// 자동으로 게시한다. 게시에 실패하면 사이트 배포(Pages)도 같이 멈춘다 — 코드만 올라가고
// 규칙은 옛 버전인 상태(2026-09-11·09-17 사고)를 만들지 않으려는 것이다.
// 설정: GitHub Secret `FIREBASE_SERVICE_ACCOUNT` — docs/firebase-rules-ci.md 참고.
// ⚠️ 시크릿 등록 전이거나 급할 때는 Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에
//    이 파일 내용을 붙여넣고 게시(Publish). 콘솔에 게시 이력이 있다고 최신인 건 아니다.
//
// 이 파일의 멤버십 판정은 Auth custom claims(companyId/role)를 먼저 본다.
// 클레임을 심는 쪽은 functions/ — `firebase deploy --only functions` 가 같이 필요하다.
// 함수를 배포하지 않아도 아래 exists()/get() 폴백으로 동작한다(읽기만 안 줄어듦).

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ 규칙 안의 exists()/get()은 "요청마다 문서 1회 읽기"로 과금된다.
    // 리스너는 스냅샷이 갱신될 때마다 규칙을 다시 평가하므로, 층 문서 1건을 받을 때마다
    // members 문서까지 같이 과금돼 읽기가 사실상 2배가 됐다.
    // → Auth custom claims(companyId/role)를 먼저 보고, 맞으면 exists()를 타지 않는다.
    //   Firebase 규칙의 ||는 단락 평가라서 앞이 true면 뒤 조회가 실행되지 않는다.
    //
    // 클레임은 Admin SDK(functions/index.js)만 쓸 수 있어 클라이언트가 위조할 수 없다.
    // 아직 클레임이 없는 기존 세션은 뒤의 exists() 폴백으로 그대로 동작한다.

    function hasCompanyClaim(companyId) {
      return request.auth != null &&
        'companyId' in request.auth.token &&
        request.auth.token.companyId == companyId;
    }

    function hasCompanyAdminClaim(companyId) {
      return hasCompanyClaim(companyId) &&
        'role' in request.auth.token &&
        request.auth.token.role == 'admin';
    }

    // 요청자가 해당 회사의 승인된 멤버(admin 또는 member)인지 확인
    function isCompanyMember(companyId) {
      return hasCompanyClaim(companyId) || (
        request.auth != null &&
        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid))
      );
    }

    // 요청자가 해당 회사의 admin인지 확인
    function isCompanyAdmin(companyId) {
      return hasCompanyAdminClaim(companyId) || (
        request.auth != null &&
        get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // --- users/{uid}: 본인만 읽고 쓸 수 있음 ---
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
      // 회사 소속·가입 신청 상태만 본인 또는 해당 회사 admin이 갱신할 수 있다.
      function membershipFieldsOnly() {
        let allowed = ['companyId', 'companyName', 'role', 'pendingCompanyId', 'pendingCompanyName', 'defectPinPresets', 'defectPinPresetsUpdatedAt'];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
      }
      function selfProfileFieldsOnly() {
        let allowed = ['defectPinPresets', 'defectPinPresetsUpdatedAt'];
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
      }
      function adminCompanyIdForUserUpdate() {
        return resource.data.get('pendingCompanyId', resource.data.get('companyId', ''));
      }
      allow update: if request.auth != null && (
        (request.auth.uid == uid && membershipFieldsOnly()) ||
        (request.auth.uid == uid && selfProfileFieldsOnly()) ||
        (request.auth.uid != uid && membershipFieldsOnly() &&
          adminCompanyIdForUserUpdate() != '' &&
          isCompanyAdmin(adminCompanyIdForUserUpdate()))
      );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // --- joinCodes/{code}: 식별코드 단건(get)은 가입 화면에서 연다.
    // 컬렉션 전체 list는 로그인 사용자만 — 익명 전체 스캔 차단. 이름 검색은 로그인 후 가입 화면. ---
    match /joinCodes/{code} {
      allow get: if true;
      allow list: if request.auth != null;
      // 새 회사를 막 생성한 관리자 본인만 자신의 회사에 대한 코드를 생성 가능
      allow create: if request.auth != null &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)) &&
        get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.adminUid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- companies/{companyId}: 회사 메타 문서 ---
    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId);
      // 회사 생성: 인증된 사용자가 자기 자신을 adminUid로 하는 새 문서를 생성할 때만 허용
      allow create: if request.auth != null && request.resource.data.adminUid == request.auth.uid;
      allow update, delete: if isCompanyAdmin(companyId);

      // members: 본인 문서는 스스로 read 가능(로그인 시 상태 조회), 목록 조회/쓰기는 admin만
      match /members/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isCompanyAdmin(companyId));
        allow list: if isCompanyAdmin(companyId);
        // 회사 최초 생성 시 admin 본인 문서 생성 + 이후 admin이 팀원을 승인 등록
        allow create: if request.auth != null &&
          (request.auth.uid == uid || isCompanyAdmin(companyId));
        allow update: if isCompanyAdmin(companyId);
        // 팀원 탈퇴(본인) 또는 관리자가 멤버 제거
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || isCompanyAdmin(companyId));
      }

      // pendingRequests: 본인이 신청서 생성, 본인 상태 조회, admin이 목록/삭제 처리
      match /pendingRequests/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isCompanyAdmin(companyId));
        allow list: if isCompanyAdmin(companyId);
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
        // 가입 대기 취소(본인) 또는 관리자 거절 처리
        allow delete: if request.auth != null &&
          (request.auth.uid == uid || isCompanyAdmin(companyId));
      }

      // rejectedRequests: admin만 생성, 본인은 자신의 거절 상태만 조회 가능
      match /rejectedRequests/{uid} {
        allow get: if request.auth != null && (request.auth.uid == uid || isCompanyAdmin(companyId));
        allow list: if isCompanyAdmin(companyId);
        allow create: if isCompanyAdmin(companyId);
        allow update: if false;
        // 거절 이력 정리(본인 탈퇴 시)
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }

    // --- safety_app/{companyId}: 건물/결함 데이터 + 도면/사진 서브컬렉션 ---
    // 해당 회사의 승인된 멤버(admin/member)만 읽고 쓸 수 있음
    match /safety_app/{companyId} {
      allow read, write: if isCompanyMember(companyId);

      // 결함/NDT 데이터 — 루트 문서 1MB 한도를 피하려고 분리한 문서 (writeChunkedPdfToDocRef 재사용)
      match /bulkData/{docId} {
        allow read, write: if isCompanyMember(companyId);

        match /parts/{partId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }

      match /floorDrawings/{docId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /floorDrawingPdfs/{docId} {
        allow read, write: if isCompanyMember(companyId);

        match /parts/{partId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }

      // 도면 배율별(4000/8000/16000 등) 캐시 — floorDrawings/floorDrawingPdfs와 같은 회사 소속
      match /floorDrawingTiers/{docId} {
        allow read, write: if isCompanyMember(companyId);

        // 큰 티어는 writeChunkedPdfToDocRef → parts 서브컬렉션으로 저장
        match /parts/{partId} {
          allow read, write: if isCompanyMember(companyId);
        }
      }

      match /photos/{docId} {
        allow read, write: if isCompanyMember(companyId);
      }

      // 동기화 잠금 — 회사 루트/층 묶음과 분리 (heartbeat가 큰 문서를 다시 과금하지 않게)
      match /syncLeases/{leaseId} {
        allow read, write: if isCompanyMember(companyId);
      }

      match /siteDrawingVault/{siteKey} {
        allow read, write: if isCompanyMember(companyId);

        match /floors/{floorCode} {
          allow read, write: if isCompanyMember(companyId);

          match /parts/{partId} {
            allow read, write: if isCompanyMember(companyId);
          }
        }
      }

      // 현장 → 회차 → (동) → 층. 단동은 rounds 아래 바로 floors.
      match /sites/{siteKey} {
        allow read, write: if isCompanyMember(companyId);
        match /rounds/{roundKey} {
          allow read, write: if isCompanyMember(companyId);
          match /floors/{floorCode} {
            allow read, write: if isCompanyMember(companyId);
            match /parts/{partId} {
              allow read, write: if isCompanyMember(companyId);
            }
            match /docs/{kind} {
              allow read, write: if isCompanyMember(companyId);
              match /parts/{partId} {
                allow read, write: if isCompanyMember(companyId);
              }
            }
          }
          match /dongs/{dongKey} {
            allow read, write: if isCompanyMember(companyId);
            match /floors/{floorCode} {
              allow read, write: if isCompanyMember(companyId);
              match /parts/{partId} {
                allow read, write: if isCompanyMember(companyId);
              }
              match /docs/{kind} {
                allow read, write: if isCompanyMember(companyId);
                match /parts/{partId} {
                  allow read, write: if isCompanyMember(companyId);
                }
              }
            }
          }
        }
      }
    }

    // --- photoRelay/{sessionId}/photos/{photoId}: 태블릿↔휴대폰 실시간 사진 촬영 연동 ---
    // 휴대폰은 회사 계정 로그인 없이 Firebase 익명 인증(Anonymous Auth)만으로 접근.
    // 세션ID(QR코드)를 아는 사람만 쓸 수 있고, 임시 중계용이라 정식 결함 데이터에는 접근 불가.
    match /photoRelay/{sessionId} {
      allow read, create: if request.auth != null;
      allow update, delete: if false;

      match /photos/{photoId} {
        allow read, create: if request.auth != null;
        allow update, delete: if false;
      }
    }

    // --- app_meta/android_release: OTA 앱 업데이트 메타 ---
    // 필드 예: { versionCode, versionName, apkUrl, notes?, mandatory? }
    // 쓰기: users/{uid}.otaPublisher == true 인 계정만
    function isOtaPublisher() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('otaPublisher', false) == true;
    }

    match /app_meta/{docId} {
      allow read: if request.auth != null;
      allow create, update: if docId == 'android_release' && isOtaPublisher();
      allow delete: if false;
    }

    // --- errorLogs/{logId}: 현장 오류 자동 기록 (js/core/error-log.js) ---
    // 태블릿이 남기기만 하는 쓰기 전용 컬렉션. 고치거나 지울 수는 없다(사후 조작 방지).
    // 길이 제한은 js/core/error-log.js의 LIMITS와 같은 값 — 한쪽만 늘리면 쓰기가 거부된다.
    function errorLogShapeOk() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'at', 'atLocal', 'kind', 'message', 'stack', 'source', 'url',
          'device', 'deviceId', 'appVersion', 'uid', 'userName',
          'companyId', 'companyName', 'online', 'sameErrorToday'
        ]) &&
        d.keys().hasAll(['at', 'kind', 'message']) &&
        d.at == request.time &&
        d.kind is string && d.kind.size() <= 40 &&
        d.message is string && d.message.size() <= 500 &&
        (!('stack' in d) || (d.stack is string && d.stack.size() <= 2000)) &&
        (!('source' in d) || (d.source is string && d.source.size() <= 300)) &&
        (!('url' in d) || (d.url is string && d.url.size() <= 300)) &&
        (!('device' in d) || (d.device is string && d.device.size() <= 300));
    }

    match /errorLogs/{logId} {
      // 읽기는 회사 계정으로 로그인한 사람만. photoRelay용 익명 로그인은 제외한다.
      allow read: if request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
      allow create: if request.auth != null && errorLogShapeOk();
      allow update, delete: if false;
    }

    // 그 외 모든 경로는 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

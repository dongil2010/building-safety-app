{
  "appId": "kr.buildingsafety.inspection",
  "appName": "스마트 안전점검",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "*.googleapis.com",
      "*.gstatic.com",
      "*.firebaseapp.com",
      "*.firebaseio.com",
      "*.firebasestorage.app"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "backgroundColor": "#ffffff"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#ffffff",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#ffffff"
    }
  }
}

rules_version = '2';

// Firebase Storage
// 배포: firebase deploy --only storage
//   또는 Firebase 콘솔 → Storage → 규칙 탭에 붙여넣기 후 게시
// Blaze 필요 (Firestore 멤버십 조회). 이 프로젝트는 이미 Blaze.

service firebase.storage {
  match /b/{bucket}/o {
    function isOtaPublisher() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('otaPublisher', false) == true;
    }

    // ⚠️ firestore.exists()는 Storage 요청 1건마다 Firestore 문서 1회 읽기로 과금된다.
    // 사진/도면을 한 장 받을 때마다 members 문서가 같이 과금되던 부분.
    // → Auth custom claims를 먼저 본다. ||는 단락 평가라 클레임이 맞으면 조회가 안 일어난다.
    // 클레임이 없는 기존 세션은 아래 exists() 폴백으로 그대로 동작한다.
    // 클레임을 쓰는 쪽은 functions/index.js (Admin SDK) — 클라이언트는 못 바꾼다.
    function hasCompanyClaim(companyId) {
      return request.auth != null &&
        'companyId' in request.auth.token &&
        request.auth.token.companyId == companyId;
    }

    function isCompanyMember(companyId) {
      return hasCompanyClaim(companyId) || (
        request.auth != null &&
        firestore.exists(/databases/(default)/documents/companies/$(companyId)/members/$(request.auth.uid))
      );
    }

    function isCompanyAssetType(assetType) {
      return assetType == 'floorDrawings'
        || assetType == 'floorDrawingPdfs'
        || assetType == 'floorDrawingTiers'
        || assetType == 'photos';
    }

    function isAllowedCompanyContentType() {
      return request.resource.contentType.matches('^(image/.*|application/pdf)$');
    }

    // OTA APK — 네이티브 앱이 토큰 URL로 무인증 다운로드
    match /releases/{fileName} {
      allow read: if true;
      allow write: if isOtaPublisher()
        && request.resource.size < 120 * 1024 * 1024
        && request.resource.contentType == 'application/vnd.android.package-archive';
    }

    function allowCompanyAsset(companyId, assetType) {
      return isCompanyMember(companyId) && isCompanyAssetType(assetType);
    }

    // 레거시 평면 경로: companies/{companyId}/{assetType}/{fileName}
    match /companies/{companyId}/{assetType}/{fileName} {
      allow read: if allowCompanyAsset(companyId, assetType);
      allow create, update: if allowCompanyAsset(companyId, assetType)
        && request.resource.size < 80 * 1024 * 1024
        && isAllowedCompanyContentType();
      allow delete: if allowCompanyAsset(companyId, assetType);
    }

    // 현장 → 회차 폴더: companies/{companyId}/{site}/{round}/{assetType}/{fileName}
    match /companies/{companyId}/{site}/{round}/{assetType}/{fileName} {
      allow read: if allowCompanyAsset(companyId, assetType);
      allow create, update: if allowCompanyAsset(companyId, assetType)
        && request.resource.size < 80 * 1024 * 1024
        && isAllowedCompanyContentType();
      allow delete: if allowCompanyAsset(companyId, assetType);
    }
  }
}
